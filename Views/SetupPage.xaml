<Page x:Class="Foscamun.Views.SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:Foscamun.ViewModels"
      xmlns:properties="clr-namespace:Foscamun.Properties"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      mc:Ignorable="d"
      d:DesignWidth="900"
      d:DesignHeight="600"
      d:DataContext="{x:Null}"
      Background="{DynamicResource PrimaryBrush}"
      Foreground="{DynamicResource TextPrimaryBrush}"
      FontFamily ="{DynamicResource FontPrimary}"
      FontSize="18">

    <!-- STILI LOCALI -->
    <Page.Resources>
        <Style x:Key="LeftAlignedLabelStyle" TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <!-- Language choice: white ring, dot when checked, the others dimmed -->
        <Style x:Key="LanguageRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                                <Ellipse x:Name="Dot" Width="8" Height="8"
                                         Fill="{DynamicResource TextPrimaryBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action buttons: light filled pill, no fill when disabled -->
        <Style x:Key="SetupActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <!-- LAYOUT PRINCIPALE -->
    <Grid Margin="40 24 40 16">

        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Committee label -->
            <RowDefinition Height="Auto"/>
            <!-- Committee list -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <!-- Committee label + list -->
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <!-- Settings + action buttons -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- TITLE -->
        <TextBlock Grid.ColumnSpan="3"
                   Style="{StaticResource H3}"
                   FontWeight="Bold"
                   Margin="0,0,0,10"
                   Text="{DynamicResource ConfigureBtn}"/>

        <!-- COMMITTEE LABEL -->
        <Label Grid.Row="1"
               Style="{StaticResource LeftAlignedLabelStyle}"
               Content="{DynamicResource CommitteeLbl}"/>

        <!-- COMMITTEE LIST -->
        <ListView x:Name="CommitteesListBox" Grid.Row="2"
                  ItemsSource="{Binding Committees}"
                  SelectedItem="{Binding SelectedCommittee, Mode=TwoWay}"
                  Background="{StaticResource InputBackgroundBrush}"
                  Foreground="{StaticResource TextInputBrush}"
                  Margin="0 4 0 0"
                  MinHeight="120"
                  SelectionMode="Single" Focusable="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <!-- Black emblem without its caption: the name is written beside it -->
                        <Image Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center"
                               Stretch="Uniform"
                               Source="{Binding Name, Converter={StaticResource CommitteeEmblemConverter}}"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextInputBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
            <!-- Global rounded item style + bold when selected -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Setter Property="Padding" Value="8,2"/>
                    <Setter Property="Margin" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- SETTINGS (label + value) AND ACTION BUTTONS -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="2">

            <Grid.RowDefinitions>
                <!-- Selected Committee -->
                <RowDefinition Height="Auto"/>
                <!-- Year -->
                <RowDefinition Height="Auto"/>
                <!-- Language -->
                <RowDefinition Height="Auto"/>
                <!-- Action buttons, level with the bottom of the list -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- SELECTED COMMITTEE -->
            <Label Style="{StaticResource LeftAlignedLabelStyle}"
                   Content="{DynamicResource SelCommittee}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SelectedCommittee.Name}"
                       FontWeight="Bold"
                       Margin="32,0,0,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>

            <!-- YEAR -->
            <Label Grid.Row="1"
                   Style="{StaticResource LeftAlignedLabelStyle}"
                   Content="{DynamicResource YearLbl}"/>
            <TextBox x:Name="YearBox" Grid.Row="1" Grid.Column="1"
                     Text="{Binding Source={x:Static properties:Settings.Default},
                                    Path=Year,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     Width="96"
                     Margin="32,0,0,0"
                     HorizontalAlignment="Right"
                     TextAlignment="Right"
                     VerticalContentAlignment="Center"
                     VerticalAlignment="Center" Padding="4"/>

            <!-- LANGUAGE -->
            <Label Grid.Row="2"
                   Style="{StaticResource LeftAlignedLabelStyle}"
                   VerticalAlignment="Top"
                   Content="{DynamicResource LanguageLbl}"/>

            <!-- One choice per line: side by side they do not fit beside the label -->
            <StackPanel Grid.Row="2" Grid.Column="1"
                        Margin="32,0,0,0"
                        HorizontalAlignment="Right">

                <RadioButton x:Name="EngLangButton" Style="{StaticResource LanguageRadio}"
                             Checked="EngLangButton_Checked">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Width="18" Height="18"
                                         Source="pack://application:,,,/Resources/flags/gb.svg"
                                         Stretch="Uniform"
                                         Margin="0,0,8,0"/>
                        <TextBlock Text="English"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="FraLangButton" Style="{StaticResource LanguageRadio}"
                             Checked="FraLangButton_Checked">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Width="18" Height="18"
                                   Source="pack://application:,,,/Resources/flags/fr.svg"
                                   Stretch="Uniform"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Francais"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="EspLangButton" Style="{StaticResource LanguageRadio}"
                             Checked="EspLangButton_Checked">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Width="18" Height="18"
                                   Source="pack://application:,,,/Resources/flags/es.svg"
                                   Stretch="Uniform"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Espanol"/>
                    </StackPanel>
                </RadioButton>

            </StackPanel>

            <!-- ACTION BUTTONS -->
            <StackPanel Grid.Row="3" Grid.ColumnSpan="2"
                        Orientation="Vertical"
                        VerticalAlignment="Bottom"
                        Margin="0,28,0,0">

                <Button Style="{StaticResource SetupActionButton}" x:Name="AddCommitteeButton"
                        Tag="pack://application:,,,/Resources/Icons/add.svg"
                        Content="{DynamicResource AddCommittee}"
                        Command="{Binding AddCommitteeCommand}"/>

                <Button Style="{StaticResource SetupActionButton}" x:Name="EditButton"
                        Tag="pack://application:,,,/Resources/Icons/edit.svg"
                        Content="{DynamicResource EditCommittee}"
                        IsEnabled="{Binding IsEditCommitteeEnabled}"
                        Command="{Binding EditCommitteeCommand}"/>

                <Button Style="{StaticResource SetupActionButton}" x:Name="ICJButton"
                        Tag="pack://application:,,,/Resources/Icons/configure.svg"
                        Content="{DynamicResource EditICJBtn}"
                        IsEnabled="{Binding IsICJButtonEnabled}"
                        Command="{Binding OpenICJCommand}"/>

                <!-- No bottom margin: its edge meets the bottom of the list -->
                <Button Style="{StaticResource SetupActionButton}" x:Name="RemoveButton"
                        Margin="0"
                        Tag="pack://application:,,,/Resources/Icons/remove.svg"
                        Content="{DynamicResource RemoveBtn}"
                        IsEnabled="{Binding IsRemoveCommitteeEnabled}"
                        Command="{Binding RemoveCommitteeCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
