<Page x:Class="Foscamun.Views.SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:Foscamun.ViewModels"
      xmlns:properties="clr-namespace:Foscamun.Properties"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      mc:Ignorable="d"
      d:DesignWidth="900"
      d:DesignHeight="600"
      d:DataContext="{x:Null}"
      Background="{DynamicResource PrimaryBrush}"
      Foreground="{DynamicResource TextPrimaryBrush}"
      FontFamily ="{DynamicResource FontPrimary}"
      FontSize="18">

    <!-- STILI LOCALI -->
    <Page.Resources>
        <Style x:Key="LeftAlignedLabelStyle" TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <!-- Language choice: white ring, dot when checked, the others dimmed -->
        <Style x:Key="LanguageRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Margin" Value="28,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                                <Ellipse x:Name="Dot" Width="8" Height="8"
                                         Fill="{DynamicResource TextPrimaryBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action buttons: light filled pill, no fill when disabled -->
        <Style x:Key="SetupActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <!-- LAYOUT PRINCIPALE -->
    <Grid Margin="40 30 40 24">

        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Selected Committee -->
            <RowDefinition Height="Auto"/>
            <!-- Year -->
            <RowDefinition Height="Auto"/>
            <!-- Language -->
            <RowDefinition Height="Auto"/>
            <!-- Ask before exiting -->
            <RowDefinition Height="Auto"/>
            <!-- Committee label + list + buttons -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- TITLE -->
        <TextBlock Grid.ColumnSpan="2"
                   Style="{StaticResource H3}"
                   FontWeight="Bold"
                   Margin="0,0,0,18"
                   Text="{DynamicResource ConfigureBtn}"/>

        <!-- SELECTED COMMITTEE -->
        <Label Grid.Row="1" Grid.Column="0"
               Style="{StaticResource LeftAlignedLabelStyle}"
               Content="{DynamicResource SelCommittee}"/>
        <TextBlock Grid.Row="1" Grid.Column="1"
                   Text="{Binding SelectedCommittee.Name}"
                   FontWeight="Bold"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>

        <!-- YEAR -->
        <Label Grid.Row="2" Grid.Column="0"
               Style="{StaticResource LeftAlignedLabelStyle}"
               Content="{DynamicResource YearLbl}"/>
        <TextBox x:Name="YearBox"  Grid.Row="2" Grid.Column="1"
                 Text="{Binding Source={x:Static properties:Settings.Default},
                                Path=Year,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                 Width="96"
                 HorizontalAlignment="Right"
                 TextAlignment="Right"
                 VerticalContentAlignment="Center"
                 VerticalAlignment="Center" Padding="4"/>

        <!-- LANGUAGE LABEL -->
        <Label Grid.Row="3" Grid.Column="0"
               Style="{StaticResource LeftAlignedLabelStyle}"
               Content="{DynamicResource LanguageLbl}"/>

        <!-- LANGUAGE BUTTONS -->
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

            <RadioButton x:Name="EngLangButton" Style="{StaticResource LanguageRadio}" Margin="0"
                         Checked="EngLangButton_Checked">
                <StackPanel Orientation="Horizontal">
                    <svgc:SvgViewbox Width="18" Height="18"
                                     Source="pack://application:,,,/Resources/flags/gb.svg"
                                     Stretch="Uniform"
                                     Margin="0,0,8,0"/>
                    <TextBlock Text="English"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="FraLangButton" Style="{StaticResource LanguageRadio}"
                         Checked="FraLangButton_Checked">
                <StackPanel Orientation="Horizontal">
                    <svgc:SvgViewbox Width="18" Height="18"
                               Source="pack://application:,,,/Resources/flags/fr.svg"
                               Stretch="Uniform"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Francais"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="EspLangButton" Style="{StaticResource LanguageRadio}"
                         Checked="EspLangButton_Checked">
                <StackPanel Orientation="Horizontal">
                    <svgc:SvgViewbox Width="18" Height="18"
                               Source="pack://application:,,,/Resources/flags/es.svg"
                               Stretch="Uniform"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Espanol"/>
                </StackPanel>
            </RadioButton>

        </StackPanel>

        <!-- ASK BEFORE EXITING (the exit dialog can turn it off) -->
        <Label Grid.Row="4" Grid.Column="0"
               Style="{StaticResource LeftAlignedLabelStyle}"
               Content="{DynamicResource ConfirmExitLbl}"/>
        <CheckBox Grid.Row="4" Grid.Column="1"
                  Style="{StaticResource AppCheckBox}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  IsChecked="{Binding Source={x:Static properties:Settings.Default},
                                      Path=ConfirmExit, Mode=TwoWay}"/>

        <!-- COMMITTEE LABEL, LIST (beside the label) + ACTION BUTTONS -->
        <Grid Grid.Row="5" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Label Style="{StaticResource LeftAlignedLabelStyle}"
                   VerticalAlignment="Top"
                   Content="{DynamicResource CommitteeLbl}"/>

            <ListView x:Name="CommitteesListBox" Grid.Column="1"
                      ItemsSource="{Binding Committees}"
                      SelectedItem="{Binding SelectedCommittee, Mode=TwoWay}"
                      Background="{StaticResource InputBackgroundBrush}"
                      Foreground="{StaticResource TextInputBrush}"
                      Margin="24 7 0 0"
                      Height="322"
                      VerticalAlignment="Top"
                      SelectionMode="Single" Focusable="True">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <!-- Accent-blue emblem without its caption: the name is written beside it -->
                            <Image Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center"
                                   Stretch="Uniform"
                                   Source="{Binding Name, Converter={StaticResource CommitteeEmblemConverter}}"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentOnLightBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <!-- Global rounded item style + bold when selected -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="Padding" Value="8,2"/>
                        <Setter Property="Margin" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- ACTION BUTTONS: bottom-right, last one level with the bottom of the list -->
            <StackPanel Grid.Column="3"
                        Orientation="Vertical" VerticalAlignment="Bottom"
                        Margin="0,0,0,-14">

                <Button Style="{StaticResource SetupActionButton}" x:Name="AddCommitteeButton"
                        Tag="pack://application:,,,/Resources/Icons/add.svg"
                        Content="{DynamicResource AddCommittee}"
                        Command="{Binding AddCommitteeCommand}"/>

                <Button Style="{StaticResource SetupActionButton}" x:Name="EditButton"
                        Tag="pack://application:,,,/Resources/Icons/edit.svg"
                        Content="{DynamicResource EditCommittee}"
                        IsEnabled="{Binding IsEditCommitteeEnabled}"
                        Command="{Binding EditCommitteeCommand}"/>

                <Button Style="{StaticResource SetupActionButton}" x:Name="AddICJButton"
                        Tag="pack://application:,,,/Resources/Icons/add.svg"
                        Content="{DynamicResource AddICJBtn}"
                        IsEnabled="{Binding IsAddICJButtonEnabled}"
                        Command="{Binding OpenICJCommand}"/>

                <Button Style="{StaticResource SetupActionButton}" x:Name="ICJButton"
                        Tag="pack://application:,,,/Resources/Icons/edit.svg"
                        Content="{DynamicResource EditICJBtn}"
                        IsEnabled="{Binding IsICJButtonEnabled}"
                        Command="{Binding OpenICJCommand}"/>

                <Button Style="{StaticResource SetupActionButton}" x:Name="RemoveButton"
                        Tag="pack://application:,,,/Resources/Icons/remove.svg"
                        Content="{DynamicResource RemoveBtn}"
                        IsEnabled="{Binding IsRemoveCommitteeEnabled}"
                        Command="{Binding RemoveCommitteeCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
