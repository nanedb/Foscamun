<Page x:Class="Foscamun.Views.CommitteeRollCallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      mc:Ignorable="d"
      d:DesignWidth="900"
      d:DesignHeight="600"
      Background="{DynamicResource PrimaryBrush}"
      Foreground="{DynamicResource TextPrimaryBrush}"
      FontFamily="{DynamicResource FontPrimary}"
      Title="Committee Roll Call">

    <Page.Resources>
        <!-- Country row: flag and name -->
        <DataTemplate x:Key="CountryTemplateList">
            <StackPanel Orientation="Horizontal">
                <svgc:SvgViewbox Width="24" Height="16"
                                 Source="{Binding FlagPath}"
                                 Stretch="Uniform"/>
                <TextBlock Text="{Binding Name}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="15"
                           Foreground="{StaticResource TextInputBrush}"/>
            </StackPanel>
        </DataTemplate>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Committee header: takes the height the body leaves -->
            <RowDefinition Height="*"/>
            <!-- Page body: lists sized for 10 rows -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- COMMITTEE HEADER: emblem, name and topic; board on the right -->
        <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,10,28,10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Width="80" Height="80" Margin="0,0,18,0" Stretch="Uniform"
                       VerticalAlignment="Center"
                       Source="{Binding CommitteeName, Converter={StaticResource CommitteeEmblemConverter}, ConverterParameter=Light}"/>

                <!-- Right margin keeps the topic well apart from the chairs -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,60,0">
                    <TextBlock Text="{Binding CommitteeName}" FontSize="24" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- Long topics wrap on up to three lines, then are cut -->
                    <TextBlock Text="{Binding Topic}" FontSize="15" LineHeight="19"
                               LineStackingStrategy="BlockLineHeight" MaxHeight="57"
                               TextWrapping="Wrap" TextTrimming="WordEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="20,0,0,0">
                        <TextBlock Style="{StaticResource BoardName}" Text="{Binding President}"/>
                        <TextBlock Style="{StaticResource BoardRole}" Text="{DynamicResource PresidentRole}"/>
                    </StackPanel>
                    <StackPanel Margin="20,0,0,0">
                        <TextBlock Style="{StaticResource BoardName}" Text="{Binding VicePresident}"/>
                        <TextBlock Style="{StaticResource BoardRole}" Text="{DynamicResource VicePresidentRole}"/>
                    </StackPanel>
                    <StackPanel Margin="20,0,0,0">
                        <TextBlock Style="{StaticResource BoardName}" Text="{Binding Moderator}"/>
                        <TextBlock Style="{StaticResource BoardRole}" Text="{DynamicResource ModeratorRole}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PAGE BODY -->
        <Grid Grid.Row="1" Margin="28,14,28,20">
            <Grid.RowDefinitions>
                <!-- Title + session -->
                <RowDefinition Height="Auto"/>
                <!-- Progress -->
                <RowDefinition Height="Auto"/>
                <!-- Lists -->
                <RowDefinition Height="Auto"/>
                <!-- Actions -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLE + SESSION -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource SessionLbl2}" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="SessionComboBox"
                              ItemsSource="{Binding Sessions}"
                              SelectedItem="{Binding SelectedSession}"
                              VerticalAlignment="Center"
                              MinWidth="70">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextInputBrush}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <TextBlock Text="{DynamicResource RollCallBtn}" Style="{StaticResource H3}"
                           FontWeight="Bold" Margin="0" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- PROGRESS: share of present countries -->
            <DockPanel Grid.Row="1" Margin="0,10,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="Bold">
                        <Run Text="{Binding PresentCount, Mode=OneWay}"/>
                        <Run Text="{DynamicResource PresentWord}"/>
                    </TextBlock>
                    <TextBlock FontSize="13" Margin="12,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding AbsentCount, Mode=OneWay}"/>
                        <Run Text="{DynamicResource AbsentWord}"/>
                    </TextBlock>
                </StackPanel>
                <ProgressBar Height="6" VerticalAlignment="Center"
                             Minimum="0" Maximum="1" Value="{Binding PresentRatio, Mode=OneWay}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border CornerRadius="3" Background="{DynamicResource SurfaceBorderBrush}"/>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                        Background="{DynamicResource WhiteBrush}"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </DockPanel>

            <!-- LISTS: absent on the left, present on the right -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 10 rows of 28 px, plus padding and border -->
                    <RowDefinition Height="294"/>
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource ListHeader}" Text="{DynamicResource AbsentListHeader}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource ListHeader}" Text="{DynamicResource PresentListHeader}"/>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding AvailableCountries}"
                          ItemTemplate="{StaticResource CountryTemplateList}"
                          SelectedItem="{Binding SelectedCountry, Mode=OneWayToSource}"
                          MouseLeftButtonUp="AvailableCountries_Click"
                          Padding="6"/>

                <ListView Grid.Row="1" Grid.Column="2"
                          ItemsSource="{Binding PresentCountries}"
                          ItemTemplate="{StaticResource CountryTemplateList}"
                          SelectedItem="{Binding SelectedCountry, Mode=OneWayToSource}"
                          MouseLeftButtonUp="PresentCountries_Click"
                          Padding="6"/>
            </Grid>

            <!-- ACTIONS -->
            <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource OutlineButton}"
                        Content="{DynamicResource MarkAllPresentBtn}"
                        Command="{Binding MarkAllPresentCommand}"
                        MinWidth="140"/>

                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ProceedCommand}" MinWidth="200">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource ProceedToSessionBtn}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentOnLightBrush}"/>
                        <!-- Arrow in a circle, drawn in the button's blue -->
                        <Grid Width="18" Height="18" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource AccentOnLightBrush}" StrokeThickness="1.6"/>
                            <Path Data="M 5,9 H 12.5 M 9.5,6 L 12.5,9 L 9.5,12"
                                  Stroke="{DynamicResource AccentOnLightBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Grid>
    </Grid>
</Page>
