<Window x:Class="Foscamun.Views.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="Foscamun"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="/Foscamun;component/Resources/Foscamun.ico"
        Background="{StaticResource WhiteBrush}">

    <Window.Resources>

        <!-- Sidebar label: hidden when the pane is collapsed -->
        <Style x:Key="SidebarLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaneCollapsed, ElementName=Root}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar icon: fixed size, gap before the label -->
        <Style x:Key="SidebarIcon" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- Page transitions: slide + fade + blur -->
        <Storyboard x:Key="RightFrameSlideIn">
            <DoubleAnimation Storyboard.TargetName="RightFrame"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="300" To="0" Duration="0:0:0.38">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.35" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RightFrame" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.38"/>
            <DoubleAnimation Storyboard.TargetName="RightFrame"
                             Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)"
                             From="12" To="0" Duration="0:0:0.38"/>
        </Storyboard>

        <Storyboard x:Key="RightFrameSlideOut">
            <DoubleAnimation Storyboard.TargetName="RightFrame"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="300" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.25" EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RightFrame" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.28"/>
            <DoubleAnimation Storyboard.TargetName="RightFrame"
                             Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)"
                             From="0" To="10" Duration="0:0:0.28"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="56"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= SIDEBAR ======================= -->
        <Border Grid.Column="0" x:Name="Sidebar"
                Padding="6"
                Panel.ZIndex="1"
                Background="{DynamicResource SidebarGradientBrush}"
                DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="0" Opacity="0.3" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top: hamburger + logo, then navigation -->
                <StackPanel Grid.Row="0">

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource MenuButton}"
                                Click="HamburgerBtn_Click"
                                ToolTip="{DynamicResource HamburgerBtn}">
                            <svgc:SvgViewbox Style="{StaticResource SidebarIcon}" Margin="0,5,0,0"
                                             Source="pack://application:,,,/Resources/Icons/hamburger.svg"/>
                        </Button>

                        <!-- App logo, hidden when collapsed -->
                        <svgc:SvgViewbox Grid.Column="1"
                                         Width="30" Height="30" Margin="0,0,10,0"
                                         VerticalAlignment="Center" HorizontalAlignment="Right"
                                         Source="pack://application:,,,/Resources/Icons/icon.svg"
                                         Stretch="Uniform"
                                         SnapsToDevicePixels="True" UseLayoutRounding="True"
                                         AutomationProperties.Name="Foscamun logo">
                            <svgc:SvgViewbox.Style>
                                <Style TargetType="svgc:SvgViewbox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaneCollapsed, ElementName=Root}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </svgc:SvgViewbox.Style>
                        </svgc:SvgViewbox>
                    </Grid>

                    <!-- Home -->
                    <Button x:Name="HomeBtn" Style="{StaticResource IconTooltipWhenCollapsed}"
                            Margin="0,0,0,6"
                            Click="HomeBtn_Click"
                            Tag="{DynamicResource HomeBtn}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Style="{StaticResource SidebarIcon}"
                                             Source="pack://application:,,,/Resources/Icons/house.svg"/>
                            <TextBlock Style="{StaticResource SidebarLabel}" Text="{DynamicResource HomeBtn}"/>
                        </StackPanel>
                    </Button>

                    <!-- Roll call (enabled only when a committee is selected) -->
                    <Button x:Name="RollCallBtn" Style="{StaticResource IconTooltipWhenCollapsed}"
                            Margin="0,0,0,6"
                            IsEnabled="{Binding IsRollCallEnabled}"
                            Click="RollCallBtn_Click"
                            Tag="{DynamicResource RollCallBtn}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Style="{StaticResource SidebarIcon}"
                                             Source="pack://application:,,,/Resources/Icons/next.svg"/>
                            <TextBlock Style="{StaticResource SidebarLabel}" Text="{DynamicResource RollCallBtn}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom: configure + exit -->
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">

                    <Button x:Name="ConfigureBtn" Style="{StaticResource IconTooltipWhenCollapsed}"
                            Margin="0,0,0,6"
                            Click="ConfigureBtn_Click"
                            Tag="{DynamicResource ConfigureBtn}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Style="{StaticResource SidebarIcon}"
                                             Source="pack://application:,,,/Resources/Icons/configure.svg"/>
                            <TextBlock Style="{StaticResource SidebarLabel}" Text="{DynamicResource ConfigureBtn}"
                                       MaxWidth="130"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExitBtn" Style="{StaticResource IconTooltipWhenCollapsed}"
                            Margin="0,0,0,6"
                            Click="ExitBtn_Click"
                            Tag="{DynamicResource ExitBtn}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Style="{StaticResource SidebarIcon}"
                                             Source="pack://application:,,,/Resources/Icons/exit.svg"/>
                            <TextBlock Style="{StaticResource SidebarLabel}" Text="{DynamicResource ExitBtn}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====================== CONTENT AREA ====================== -->
        <Grid Grid.Column="1" Background="{DynamicResource PrimaryBrush}" ClipToBounds="True">
            <Frame x:Name="RightFrame" NavigationUIVisibility="Hidden" RenderTransformOrigin="0,0">
                <Frame.RenderTransform>
                    <TranslateTransform X="0"/>
                </Frame.RenderTransform>
                <Frame.Effect>
                    <BlurEffect Radius="0"/>
                </Frame.Effect>
            </Frame>
        </Grid>
    </Grid>
</Window>
