<Window x:Class="Foscamun.Views.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="Foscamun"
        Height="720" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="/Foscamun;component/Resources/Foscamun.ico"
        Background="{StaticResource WhiteBrush}">

    <Window.Resources>

        <!-- Sidebar label: hidden when the pane is collapsed -->
        <Style x:Key="SidebarLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <!-- Room left by the expanded pane (200) after padding, margins and icon -->
            <Setter Property="MaxWidth" Value="128"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaneCollapsed, ElementName=Root}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar icon: fixed size, gap before the label -->
        <Style x:Key="SidebarIcon" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Sidebar item: icon + label, tooltip with the label when the pane is collapsed -->
        <Style x:Key="SidebarItem" TargetType="Button" BasedOn="{StaticResource IconTooltipWhenCollapsed}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Page transitions: slide + fade + blur -->
        <Storyboard x:Key="RightFrameSlideIn">
            <DoubleAnimation Storyboard.TargetName="RightFrame"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="300" To="0" Duration="0:0:0.38">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.35" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RightFrame" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.38"/>
            <DoubleAnimation Storyboard.TargetName="RightFrame"
                             Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)"
                             From="12" To="0" Duration="0:0:0.38"/>
        </Storyboard>

        <Storyboard x:Key="RightFrameSlideOut">
            <DoubleAnimation Storyboard.TargetName="RightFrame"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="300" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.25" EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RightFrame" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.28"/>
            <DoubleAnimation Storyboard.TargetName="RightFrame"
                             Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)"
                             From="0" To="10" Duration="0:0:0.28"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="64"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= SIDEBAR ======================= -->
        <Border Grid.Column="0" x:Name="Sidebar"
                Padding="6"
                Panel.ZIndex="1"
                Background="{DynamicResource SidebarGradientBrush}"
                DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="0" Opacity="0.3" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: hamburger on the left, logo on the right (hidden when collapsed) -->
                <Grid Grid.Row="0" Margin="0,2,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource MenuButton}"
                            Height="34" HorizontalAlignment="Left"
                            Click="HamburgerBtn_Click"
                            ToolTip="{DynamicResource HamburgerBtn}">
                        <svgc:SvgViewbox Width="20" Height="15" Stretch="Uniform"
                                         Source="pack://application:,,,/Resources/Icons/hamburger.svg"/>
                    </Button>

                    <!-- App logo, hidden when collapsed -->
                    <svgc:SvgViewbox Grid.Column="1"
                                     Width="30" Height="30" Margin="0,0,10,0"
                                     VerticalAlignment="Center" HorizontalAlignment="Right"
                                     Source="pack://application:,,,/Resources/Icons/icon.svg"
                                     Stretch="Uniform"
                                     SnapsToDevicePixels="True" UseLayoutRounding="True"
                                     AutomationProperties.Name="Foscamun logo">
                        <svgc:SvgViewbox.Style>
                            <Style TargetType="svgc:SvgViewbox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaneCollapsed, ElementName=Root}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </svgc:SvgViewbox.Style>
                    </svgc:SvgViewbox>
                </Grid>

                <!-- Flow: previous page, current page (inert), next page.
                     Filled in code-behind from the page shown (see UpdateSidebar). -->
                <StackPanel Grid.Row="1">
                    <Button x:Name="PreviousBtn" Style="{StaticResource SidebarItem}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox x:Name="PreviousIcon" Style="{StaticResource SidebarIcon}"/>
                            <TextBlock x:Name="PreviousLabel" Style="{StaticResource SidebarLabel}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CurrentBtn" Style="{StaticResource SidebarItem}"
                            Background="{DynamicResource SidebarActiveBrush}"
                            IsHitTestVisible="False" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox x:Name="CurrentIcon" Style="{StaticResource SidebarIcon}"/>
                            <TextBlock x:Name="CurrentLabel" Style="{StaticResource SidebarLabel}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NextBtn" Style="{StaticResource SidebarItem}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox x:Name="NextIcon" Style="{StaticResource SidebarIcon}"/>
                            <TextBlock x:Name="NextLabel" Style="{StaticResource SidebarLabel}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom: Setup (marked as current on Setup and its edit pages) + Exit -->
                <StackPanel Grid.Row="3">

                    <Button x:Name="ConfigureBtn" Style="{StaticResource SidebarItem}"
                            Click="ConfigureBtn_Click"
                            Tag="{DynamicResource ConfigureBtn}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox x:Name="ConfigureIcon" Style="{StaticResource SidebarIcon}"
                                             Source="pack://application:,,,/Resources/Icons/configure.svg"/>
                            <TextBlock Style="{StaticResource SidebarLabel}" Text="{DynamicResource ConfigureBtn}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExitBtn" Style="{StaticResource SidebarItem}"
                            Click="ExitBtn_Click"
                            Tag="{DynamicResource ExitBtn}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Style="{StaticResource SidebarIcon}"
                                             Source="pack://application:,,,/Resources/Icons/exit.svg"/>
                            <TextBlock Style="{StaticResource SidebarLabel}" Text="{DynamicResource ExitBtn}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====================== CONTENT AREA ====================== -->
        <Grid Grid.Column="1" Background="{DynamicResource PrimaryBrush}" ClipToBounds="True">
            <Frame x:Name="RightFrame" NavigationUIVisibility="Hidden" RenderTransformOrigin="0,0"
                   Navigated="RightFrame_Navigated">
                <Frame.RenderTransform>
                    <TranslateTransform X="0"/>
                </Frame.RenderTransform>
                <Frame.Effect>
                    <BlurEffect Radius="0"/>
                </Frame.Effect>
            </Frame>
        </Grid>
    </Grid>
</Window>
