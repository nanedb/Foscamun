<Window x:Class="Foscamun.Views.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource FontPrimary}"
        FontSize="17"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- App-styled replacement for the Windows MessageBox: see AppDialog.Show -->
    <Grid Margin="20">
        <!-- Shadow on its own layer, so the text keeps sharp rendering -->
        <Border CornerRadius="{StaticResource CornerRadiusLarge}" Background="{DynamicResource PrimaryBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4"
                                  Color="{StaticResource PrimaryDarkColor}"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="{StaticResource CornerRadiusLarge}"
                Background="{DynamicResource PrimaryBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                MinWidth="400" MaxWidth="580"
                MouseLeftButtonDown="Panel_MouseLeftButtonDown">
            <Grid Margin="28,22,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleText" FontSize="21" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,0,0,14"/>

                <DockPanel Grid.Row="1">
                    <svgc:SvgViewbox x:Name="IconView" DockPanel.Dock="Left"
                                     Width="34" Height="34" Margin="0,0,18,0"
                                     VerticalAlignment="Top" Stretch="Uniform"
                                     Visibility="Collapsed"/>
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="24"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <CheckBox x:Name="OptionBox" Grid.Row="2" Margin="0,18,0,0"
                          Style="{StaticResource AppCheckBox}" Visibility="Collapsed"/>

                <StackPanel x:Name="ButtonPanel" Grid.Row="3" Margin="0,22,0,0"
                            Orientation="Horizontal" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
