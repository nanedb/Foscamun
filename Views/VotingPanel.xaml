<UserControl x:Class="Foscamun.Views.VotingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="680"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{DynamicResource FontPrimary}">

    <!-- Body of the committee and ICJ voting pages: one voter at a time.
         The page feeds it with ShowVoter and handles the three vote events. -->

    <UserControl.Resources>
        <SolidColorBrush x:Key="GlassBrush" Color="#29FFFFFF"/>
        <SolidColorBrush x:Key="SegmentTodoBrush" Color="#47FFFFFF"/>

        <!-- Wide vote button: label on the left, keyboard shortcut (Tag) on the right -->
        <Style x:Key="VoteButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="12"/>
                            <Border x:Name="Overlay" Background="{DynamicResource PrimaryDarkBrush}"
                                    CornerRadius="12" Opacity="0"/>
                            <!-- Explicit TextBlocks: the app-wide TextBlock style would make the text white -->
                            <DockPanel Margin="22,0">
                                <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding Tag}"
                                           VerticalAlignment="Center" FontSize="12" FontFamily="Consolas"
                                           Opacity="0.7" Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </DockPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,26,34,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP: round and progress, title; committee and session on the right -->
        <DockPanel>
            <TextBlock x:Name="ContextText" DockPanel.Dock="Right" FontSize="14" Margin="20,2,0,0"
                       VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel>
                <TextBlock x:Name="ProgressText" FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{DynamicResource CastVoteTitle}" FontSize="30" FontWeight="Bold" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- VOTER: flag, name, progress segments and who comes next -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Hidden for ICJ jurors, who have no flag -->
            <svgc:SvgViewbox x:Name="FlagView" Width="260" Height="176" Margin="0,0,44,0"
                             Stretch="Uniform" VerticalAlignment="Center"/>

            <!-- MaxWidth grows in code when there is no flag -->
            <StackPanel x:Name="VoterText" Grid.Column="1" VerticalAlignment="Center" MaxWidth="440">
                <!-- Long names wrap on two lines, then are cut -->
                <TextBlock x:Name="NameText" FontSize="64" FontWeight="Bold" LineHeight="66"
                           LineStackingStrategy="BlockLineHeight" MaxHeight="132"
                           TextWrapping="Wrap" TextTrimming="WordEllipsis"/>
                <ItemsControl x:Name="Segments" Margin="0,18,0,0" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="NextText" FontSize="13" Margin="0,12,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- VOTES: Approve stands out; Abstain may be hidden in later rounds -->
        <UniformGrid Grid.Row="2" Rows="1" Margin="-5,0">
            <Button x:Name="ApproveButton" Tag="A" Content="{DynamicResource ApproveBtn}" Click="Approve_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource VoteButton}">
                        <Setter Property="Background" Value="{DynamicResource WhiteBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentOnLightBrush}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="AbstainButton" Tag="S" Content="{DynamicResource AbstainBtn}"
                    Style="{StaticResource VoteButton}" Click="Abstain_Click"/>
            <Button x:Name="RejectButton" Tag="D" Content="{DynamicResource RejectBtn}"
                    Style="{StaticResource VoteButton}" Click="Reject_Click"/>
        </UniformGrid>
    </Grid>
</UserControl>
