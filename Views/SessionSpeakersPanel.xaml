<UserControl x:Class="Foscamun.Views.SessionSpeakersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="520"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{DynamicResource FontPrimary}">

    <!-- Everything below the header of a session page (committee and ICJ):
         "now speaking" panel with the clock, Start/Pause - Warn - Next,
         available and speakers lists, warnings and the voting button.
         DataContext: a SessionViewModelBase (speakers expose Name, FlagPath, Warnings). -->

    <UserControl.Resources>
        <!-- Navy text on the light card, and its muted grey -->
        <SolidColorBrush x:Key="CardTextBrush" Color="{StaticResource PrimaryDarkColor}"/>
        <SolidColorBrush x:Key="CardMutedBrush" Color="#FF6B7D8C"/>
        <SolidColorBrush x:Key="ChipBrush" Color="#1A0A2A44"/>
        <SolidColorBrush x:Key="GlassBrush" Color="#29FFFFFF"/>
        <SolidColorBrush x:Key="WarningCountBrush" Color="#FFC07800"/>
        <SolidColorBrush x:Key="FinalSecondsBrush" Color="#FFC62828"/>

        <!-- Speaker row: flag (none for ICJ jurors) and name -->
        <!-- DockPanel, not a horizontal StackPanel: the name must get a finite width to be trimmed -->
        <DataTemplate x:Key="AvailableRow">
            <DockPanel>
                <svgc:SvgViewbox Width="24" Height="16" Source="{Binding FlagPath}" Stretch="Uniform"/>
                <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="15" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextInputBrush}"/>
            </DockPanel>
        </DataTemplate>

        <!-- Speakers list row: position, flag and name -->
        <DataTemplate x:Key="SpeakerRow">
            <DockPanel>
                <TextBlock Width="18" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                           FontFamily="Consolas" Foreground="{StaticResource CardMutedBrush}"
                           Text="{Binding (ItemsControl.AlternationIndex),
                                  RelativeSource={RelativeSource AncestorType=ListViewItem},
                                  Converter={StaticResource IndexToNumberConverter}}"/>
                <svgc:SvgViewbox Width="24" Height="16" Source="{Binding FlagPath}" Stretch="Uniform"/>
                <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="15" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextInputBrush}"/>
            </DockPanel>
        </DataTemplate>

        <!-- Warnings row: flag, name, count on the right -->
        <DataTemplate x:Key="WarningRow">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Warnings}" Margin="8,0,2,0"
                           VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource WarningCountBrush}"/>
                <svgc:SvgViewbox Width="24" Height="16" Source="{Binding FlagPath}" Stretch="Uniform"/>
                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"
                           FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextInputBrush}"/>
            </DockPanel>
        </DataTemplate>

        <!-- Small rounded chip on the light card (-, +, presets) -->
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ChipBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource CardTextBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource CardTextBrush}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="7"/>
                            <Border x:Name="Overlay" Background="{StaticResource CardTextBrush}"
                                    CornerRadius="7" Opacity="0"/>
                            <!-- An explicit TextBlock: the app-wide TextBlock style would make the text white -->
                            <TextBlock Margin="{TemplateBinding Padding}" Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.18"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Translucent white button on the blue background -->
        <Style x:Key="GlassButton" TargetType="Button" BasedOn="{StaticResource MenuButton}">
            <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Icon (Tag) + text inside a GlassButton -->
        <DataTemplate x:Key="IconLabel">
            <StackPanel Orientation="Horizontal">
                <svgc:SvgViewbox Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                 Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- NOW SPEAKING card + clock buttons -->
        <Grid Margin="22,16,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <!-- Turns Warn-orange once the speaking time has run out -->
            <Border CornerRadius="14" Padding="18,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOvertime}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource PrimaryDarkColor}" Opacity="0.22"
                                      BlurRadius="26" ShadowDepth="8" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Flag of the speaker (hidden when nobody speaks, and for ICJ jurors) -->
                    <svgc:SvgViewbox Width="92" Height="62" Margin="0,0,18,0" Stretch="Uniform"
                                     VerticalAlignment="Center"
                                     Source="{Binding CurrentSpeaker.FlagPath}"
                                     Visibility="{Binding CurrentSpeaker.FlagPath, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource NowSpeakingLbl}" FontSize="11.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource AccentOnLightBrush}"/>
                                    <Style.Triggers>
                                        <!-- Blue on orange reads poorly: navy instead -->
                                        <DataTrigger Binding="{Binding IsOvertime}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource CardTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="32" FontWeight="Bold" LineHeight="35"
                                   LineStackingStrategy="BlockLineHeight" MaxHeight="70"
                                   TextWrapping="Wrap" TextTrimming="WordEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding CurrentSpeaker.Name}"/>
                                    <Setter Property="Foreground" Value="{StaticResource CardTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSpeaker}" Value="{x:Null}">
                                            <Setter Property="Text" Value="{DynamicResource NoSpeakerLbl}"/>
                                            <Setter Property="Foreground" Value="{StaticResource CardMutedBrush}"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Clock, speaking time and presets -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TimerText}" HorizontalAlignment="Right"
                                   FontSize="44" FontWeight="Bold" LineHeight="46"
                                   LineStackingStrategy="BlockLineHeight"
                                   Typography.NumeralAlignment="Tabular">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource CardTextBrush}"/>
                                    <Style.Triggers>
                                        <!-- Red in the last seconds; over time it stays navy on the orange card -->
                                        <DataTrigger Binding="{Binding IsFinalSeconds}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource FinalSecondsBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentSpeaker}" Value="{x:Null}">
                                            <Setter Property="Opacity" Value="0.35"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <TextBlock Text="{DynamicResource SpeakingTimeLbl}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource CardMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOvertime}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource CardTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Style="{StaticResource ChipButton}" Content="–" FontWeight="Bold" Padding="0"
                                    Command="{Binding DecreaseTimeCommand}"/>
                            <!-- Editable: click, type (1:30, 2, 45...), Enter; Esc gives up -->
                            <Border MinWidth="62" Height="26" Margin="6,0" CornerRadius="7"
                                    BorderThickness="1" ToolTip="{DynamicResource SpeakingTimeEditTip}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource ChipBrush}"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource CardMutedBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentOnLightBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBox x:Name="SpeakingTimeBox" Text="{Binding SpeakingTimeInput}"
                                         FontSize="15" Width="54" Height="22" MinHeight="0" Padding="0" Margin="0" MaxLength="5"
                                         HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                         Typography.NumeralAlignment="Tabular"
                                         Foreground="{StaticResource CardTextBrush}"
                                         CaretBrush="{StaticResource CardTextBrush}"
                                         PreviewKeyDown="SpeakingTimeBox_PreviewKeyDown"
                                         GotKeyboardFocus="SpeakingTimeBox_GotKeyboardFocus"
                                         PreviewMouseLeftButtonDown="SpeakingTimeBox_PreviewMouseLeftButtonDown">
                                    <TextBox.Template>
                                        <!-- Bare text: the app-wide input style would draw its own box -->
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" Padding="0" Margin="0"
                                                          HorizontalScrollBarVisibility="Hidden"
                                                          VerticalScrollBarVisibility="Hidden"/>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                            </Border>
                            <Button Style="{StaticResource ChipButton}" Content="+" FontWeight="Bold" Padding="0"
                                    Command="{Binding IncreaseTimeCommand}"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Presets}" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Height="24" FontSize="12.5" Margin="5,0,0,0"
                                            Padding="10,0"
                                            Command="{Binding DataContext.SetPresetCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Start/Pause (with Reset beside it), Warn, Next -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <DockPanel>
                <Button DockPanel.Dock="Right" Width="38" Margin="8,0,0,0"
                        Command="{Binding ResetTimerCommand}" ToolTip="{DynamicResource ResetTimerTip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GlassButton}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <!-- The button template keeps 12 px of margin each side: the icon reaches into it, or it would be cut -->
                    <svgc:SvgViewbox Width="16" Height="16" Margin="-6,0" Stretch="Uniform"
                                     Source="pack://application:,,,/Resources/Icons/reset.svg"/>
                </Button>
                <Button Command="{Binding StartPauseCommand}" ToolTip="{DynamicResource StartPauseTip}"
                        ContentTemplate="{StaticResource IconLabel}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GlassButton}">
                            <Setter Property="Content" Value="{DynamicResource StartBtn}"/>
                            <Setter Property="Tag" Value="pack://application:,,,/Resources/Icons/start.svg"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Content" Value="{DynamicResource PauseBtn}"/>
                                    <Setter Property="Tag" Value="pack://application:,,,/Resources/Icons/pause.svg"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                </DockPanel>

                <!-- Warn: orange with navy icon and text -->
                <Button Command="{Binding WarnCurrentSpeakerCommand}" Margin="0,8">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GlassButton}">
                            <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource CardTextBrush}"/>
                            <Setter Property="TextElement.Foreground" Value="{StaticResource CardTextBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                            <Path Fill="{StaticResource CardTextBrush}"
                                  Data="M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM222.93,203.8a8.5,8.5,0,0,1-7.48,4.2H40.55a8.5,8.5,0,0,1-7.48-4.2,7.59,7.59,0,0,1,0-7.72L120.52,44.21a8.75,8.75,0,0,1,15,0l87.45,151.87A7.59,7.59,0,0,1,222.93,203.8ZM120,144V104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm20,36a12,12,0,1,1-12-12A12,12,0,0,1,140,180Z"/>
                        </Viewbox>
                        <TextBlock Text="{DynamicResource WarnBtn}" VerticalAlignment="Center"
                                   Foreground="{StaticResource CardTextBrush}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource GlassButton}" Command="{Binding NextSpeakerCommand}"
                        Content="{DynamicResource NextBtn}" ContentTemplate="{StaticResource IconLabel}"
                        Tag="pack://application:,,,/Resources/Icons/next.svg"/>
            </StackPanel>
        </Grid>

        <!-- LISTS: available, speakers list, warnings + voting -->
        <Grid Grid.Row="1" Margin="22,16,22,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="210"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource ListHeader}">
                <Run Text="{DynamicResource AvailableHeader}"/><Run Text=" · "/><Run Text="{Binding AvailableSpeakers.Count, Mode=OneWay}"/>
            </TextBlock>
            <ListView Grid.Row="1" Padding="6"
                      ItemsSource="{Binding AvailableSpeakers}"
                      ItemTemplate="{StaticResource AvailableRow}"
                      ToolTip="{DynamicResource AddSpeakerTip}"
                      MouseLeftButtonUp="AvailableList_Click"/>

            <TextBlock Grid.Column="2" Style="{StaticResource ListHeader}">
                <Run Text="{DynamicResource SpeakersHeader}"/><Run Text=" · "/><Run Text="{Binding SpeakersList.Count, Mode=OneWay}"/>
            </TextBlock>
            <!-- The first row is the speaker: highlighted and bold -->
            <ListView Grid.Row="1" Grid.Column="2" Padding="6"
                      ItemsSource="{Binding SpeakersList}"
                      ItemTemplate="{StaticResource SpeakerRow}"
                      AlternationCount="100000"
                      ToolTip="{DynamicResource RemoveSpeakerTip}"
                      MouseLeftButtonUp="SpeakersList_Click">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                <Setter Property="Background" Value="{StaticResource InputSelectedBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <TextBlock Grid.Column="4" Style="{StaticResource ListHeader}" Text="{DynamicResource WarningsHeader}"/>
            <DockPanel Grid.Row="1" Grid.Column="4" LastChildFill="False">
                <!-- Warned countries: orange frame, grows with its rows up to three (30 px each + 5/4 px padding; the 4th row starts inside the bottom padding but its flag, centred, stays hidden), then scrolls -->
                <Border DockPanel.Dock="Top" Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <ListView ItemsSource="{Binding WarnedList}"
                                  ItemTemplate="{StaticResource WarningRow}"
                                  SelectedItem="{Binding SelectedWarned, Mode=TwoWay}"
                                  BorderThickness="0" Background="Transparent" Padding="5,5,5,4"
                                  MaxHeight="99" HorizontalContentAlignment="Stretch">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <!-- Fixed row height (plus 1 px margin above and below), so three rows are exactly 90 px -->
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="{StaticResource CornerRadiusSmall}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputSelectedBrush}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <!-- Empty state -->
                        <TextBlock Text="{DynamicResource NoWarningsLbl}" Margin="12,10" FontSize="14"
                                   FontStyle="Italic" Foreground="{StaticResource CardMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WarnedList.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Button DockPanel.Dock="Top" Style="{StaticResource GlassButton}" Height="34" FontSize="14"
                        Margin="0,8,0,0"
                        Command="{Binding RemoveWarningCommand}"
                        Content="{DynamicResource RemoveWarningBtn}" ContentTemplate="{StaticResource IconLabel}"
                        Tag="pack://application:,,,/Resources/Icons/remove.svg"/>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Height="44"
                        Command="{Binding OpenVotingCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource OpenVotingBtn}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentOnLightBrush}"/>
                        <!-- Arrow in a circle, as on Roll call -->
                        <Grid Width="18" Height="18" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource AccentOnLightBrush}" StrokeThickness="1.6"/>
                            <Path Data="M 5,9 H 12.5 M 9.5,6 L 12.5,9 L 9.5,12"
                                  Stroke="{DynamicResource AccentOnLightBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
