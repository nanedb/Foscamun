<Page x:Class="Foscamun.Views.ICJEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      xmlns:conv="clr-namespace:Foscamun.Converters"
      mc:Ignorable="d"
      d:DesignWidth="900"
      d:DesignHeight="600"
      Background="{DynamicResource PrimaryBrush}"
      Foreground="{DynamicResource TextPrimaryBrush}"
      Title="EditICJPage">

    <Page.Resources>
        <!-- Advocates of one side (plaintiffs or defense): list with the flag of the
             represented country, then name + country of a new advocate and add/remove -->
        <DataTemplate x:Key="AdvocateListTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListView Grid.ColumnSpan="2"
                          Margin="5 0 5 8"
                          Background="{DynamicResource InputBackgroundBrush}"
                          ItemsSource="{Binding Advocates}"
                          SelectedItem="{Binding SelectedAdvocate}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <svgc:SvgViewbox Width="28" Height="19"
                                                 Source="{Binding FlagPath}"
                                                 Stretch="Uniform"/>
                                <TextBlock Text="{Binding Name}" Margin="10 0 0 0"
                                           VerticalAlignment="Center"
                                           Foreground="Black" FontSize="14"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="1" Text="{DynamicResource AdvocateNameLbl}"
                           Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="5 0 10 5"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0 0 5 5"/>

                <TextBlock Grid.Row="2" Text="{DynamicResource AdvocateCountryLbl}"
                           Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="5 0 10 5"/>
                <ComboBox Grid.Row="2" Grid.Column="1"
                          ItemsSource="{Binding Countries}"
                          SelectedItem="{Binding NewCountry}"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Name"
                          Margin="0 0 5 5"/>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2"
                            Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}"
                            Tag="pack://application:,,,/Resources/Icons/add.svg"
                            Content="{DynamicResource AddBtn}"
                            Command="{Binding AddCommand}"/>
                    <Button Style="{StaticResource IconButton}"
                            Tag="pack://application:,,,/Resources/Icons/remove.svg"
                            Content="{DynamicResource RemoveBtn}"
                            Command="{Binding RemoveCommand}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!--Titolo-->
            <RowDefinition Height="*"/>
            <!--Contenuto-->
            <RowDefinition Height="Auto"/>
            <!--Pulsanti-->
        </Grid.RowDefinitions>

        <!-- TITOLO -->
        <TextBlock Text="{DynamicResource ICJTitle}"
                Style="{StaticResource H3}" Margin="0"/>

        <!-- CONTENUTO -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!--Colonna 1: Judge, Vice Judge, Topic-->
                <ColumnDefinition Width="*"/>
                <!--Colonna 2: Advocates (plaintiffs and defense lists)-->
                <ColumnDefinition Width="1.3*"/>
                <!--Colonna 3: Jurors-->
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="{DynamicResource BoardLbl}"
                      Padding="4" BorderBrush="#FFCCCCCC"
                      BorderThickness="0.6" Margin="0 0 20 10">
                <Grid>
                    <!-- COLONNA 1: Judge, Vice Judge, Topic -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource JudgeLbl2}" Style="{StaticResource Caption}"
                               Margin="0 0 0 5"/>
                    <TextBox Grid.Row="1" Text="{Binding Judge, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5 0 0 20"/>
                    <TextBlock Grid.Row="2" Text="{DynamicResource ViceJudgesLbl}" Style="{StaticResource Caption}"
                               Margin="0 0 0 10"/>
                    <TextBox Grid.Row="3" Text="{Binding ViceJudge1, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5 0 0 5"/>
                    <TextBox Grid.Row="4" Text="{Binding ViceJudge2, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5 0 0 20"/>
                    <TextBlock Grid.Row="5" Text="{DynamicResource TopicLbl}" Style="{StaticResource Caption}"
                               Margin="0 0 0 10"/>
                    <TextBox Grid.Row="6" Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5 0 0 0" TextWrapping="Wrap"/>
                </Grid>
            </GroupBox>

            <Grid Grid.Column="1">
                <!-- COLONNA 2: Advocates -->
                <GroupBox Grid.Column="0" Header="{DynamicResource AdvocatesLbl}"
                      Padding="5" BorderBrush="#FFCCCCCC"
                      BorderThickness="0.6" Margin="0 0 20 10">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource PlaintiffsLbl}" Style="{StaticResource Caption}"
                                   Margin="0 0 0 5"/>
                        <ContentControl Grid.Row="1" Content="{Binding Plaintiffs}"
                                        ContentTemplate="{StaticResource AdvocateListTemplate}"
                                        Focusable="False" IsTabStop="False"/>

                        <TextBlock Grid.Row="2" Text="{DynamicResource DefenseLbl}" Style="{StaticResource Caption}"
                                   Margin="0 10 0 5"/>
                        <ContentControl Grid.Row="3" Content="{Binding Defense}"
                                        ContentTemplate="{StaticResource AdvocateListTemplate}"
                                        Focusable="False" IsTabStop="False"/>
                    </Grid>
                </GroupBox>

            </Grid>

            <!-- COLONNA 3: Jurors -->
            <Grid Grid.Column="2">
                <GroupBox Header="{DynamicResource JurorsLbl}"
                      Padding="5" BorderBrush="#FFCCCCCC"
                      BorderThickness="0.6" Margin="0 0 0 10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <ListView Grid.Row="0" x:Name="JurorsList"
                                  Margin="5 10 5 10"
                                  Background="{DynamicResource InputBackgroundBrush}"
                                  ItemsSource="{Binding Jurors}"
                                  SelectedItem="{Binding SelectedJuror}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="Black" FontSize="14"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Grid.Row="1" Text="{DynamicResource NewJurorNameLbl}"
                                   Style="{StaticResource Caption}"
                                   Margin="0 0 0 5"/>
                        <TextBox Grid.Row="2" x:Name="JurorBox"
                                 Text="{Binding NewJurorName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5 0 5 10"/>
                        <Button Grid.Row="3" Style="{StaticResource IconButton}"
                                Tag="pack://application:,,,/Resources/Icons/add.svg"
                                Content="{DynamicResource AddJurorBtn}"
                                Command="{Binding AddJurorCommand}"
                                HorizontalAlignment="Right"/>
                        <Button Grid.Row="4" Style="{StaticResource IconButton}"
                                Tag="pack://application:,,,/Resources/Icons/remove.svg"
                                Content="{DynamicResource RemoveJurorBtn}"
                                Command="{Binding RemoveJurorCommand}"
                                HorizontalAlignment="Right"/>
                        </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- FOOTER PULSANTI OK / CANCEL -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 0 10 0">

            <!-- CANCEL -->
            <Button Style="{StaticResource IconButton}"
                    Tag="pack://application:,,,/Resources/Icons/close.svg"
                    Content="{DynamicResource CancelBtn}"
                    Command="{Binding CancelCommand}" Width="150"/>

            <!-- OK -->
            <Button Style="{StaticResource IconButton}"
                    Tag="pack://application:,,,/Resources/Icons/check.svg"
                    Content="{DynamicResource OkBtn}"
                    Command="{Binding SaveCommand}" Width="150"/>
            
        </StackPanel>

    </Grid>
    
</Page>
