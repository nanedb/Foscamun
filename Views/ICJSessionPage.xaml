<Page x:Class="Foscamun.Views.ICJSessionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:Foscamun.Views"
      mc:Ignorable="d"
      d:DesignWidth="800"
      d:DesignHeight="680"
      Background="{DynamicResource PrimaryBrush}"
      Foreground="{DynamicResource TextPrimaryBrush}"
      FontFamily="{DynamicResource FontPrimary}"
      Title="ICJ Session">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- COURT HEADER: same as the ICJ Roll call (emblem, name and case; judges on the right).
             MinHeight matches the Roll call band at the default window size. -->
        <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" MinHeight="112">
            <Grid Margin="24,10,28,10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Width="80" Height="80" Margin="0,0,18,0" Stretch="Uniform"
                       VerticalAlignment="Center"
                       Source="{Binding Source=ICJ, Converter={StaticResource CommitteeEmblemConverter}, ConverterParameter=Light}"/>

                <!-- Right margin keeps the case well apart from the judges -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,60,0">
                    <TextBlock Text="{DynamicResource ICJTitle}" FontSize="24" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- Long cases wrap on up to three lines, then are cut -->
                    <TextBlock Text="{Binding Topic}" FontSize="15" LineHeight="19"
                               LineStackingStrategy="BlockLineHeight" MaxHeight="57"
                               TextWrapping="Wrap" TextTrimming="WordEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Judges, with the session number underneath (fits within the emblem's height) -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="20,0,0,0">
                            <TextBlock Style="{StaticResource BoardName}" Text="{Binding Judge}"/>
                            <TextBlock Style="{StaticResource BoardRole}" Text="{DynamicResource JudgeLbl2}"/>
                        </StackPanel>
                        <StackPanel Margin="20,0,0,0">
                            <TextBlock Style="{StaticResource BoardName}" Text="{Binding ViceJudge1}"/>
                            <TextBlock Style="{StaticResource BoardRole}" Text="{DynamicResource ViceJudgeRole}"/>
                        </StackPanel>
                        <StackPanel Margin="20,0,0,0">
                            <TextBlock Style="{StaticResource BoardName}" Text="{Binding ViceJudge2}"/>
                            <TextBlock Style="{StaticResource BoardRole}" Text="{DynamicResource ViceJudgeRole}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" Margin="0,8,0,0" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{DynamicResource SessionLbl2}"/>
                        <Run Text="{Binding Session, Mode=OneWay}" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Now speaking, lists, warnings and voting (shared with the committee session) -->
        <local:SessionSpeakersPanel Grid.Row="1"/>
    </Grid>
</Page>
