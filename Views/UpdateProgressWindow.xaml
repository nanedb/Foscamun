<Window x:Class="Foscamun.Views.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource FontPrimary}"
        FontSize="17"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- Download of a new version: same look as AppDialog, with a progress bar and Cancel -->
    <Grid Margin="20">
        <Border CornerRadius="{StaticResource CornerRadiusLarge}" Background="{DynamicResource PrimaryBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4"
                                  Color="{StaticResource PrimaryDarkColor}"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="{StaticResource CornerRadiusLarge}"
                Background="{DynamicResource PrimaryBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                Width="460">
            <StackPanel Margin="28,22,28,20">
                <TextBlock x:Name="TitleText" FontSize="21" FontWeight="Bold" Margin="0,0,0,14"/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>

                <!-- Bar: white on the faint track, like the Roll call progress -->
                <Grid Height="10" Margin="0,16,0,0">
                    <Border CornerRadius="5" Background="#40FFFFFF"/>
                    <Border x:Name="ProgressFill" CornerRadius="5" Background="White"
                            HorizontalAlignment="Left" Width="0"/>
                </Grid>

                <Button Style="{StaticResource IconButton}" Margin="0,22,0,0"
                        HorizontalAlignment="Right" Height="38" MinWidth="120"
                        HorizontalContentAlignment="Center" IsCancel="True"
                        Background="{DynamicResource SurfaceBrush}" FocusVisualStyle="{x:Null}"
                        Tag="pack://application:,,,/Resources/Icons/close.svg"
                        Content="{DynamicResource CancelBtn}" Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
