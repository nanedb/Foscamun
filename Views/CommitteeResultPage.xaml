<Page x:Class="Foscamun.Views.CommitteeResultPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:Foscamun.Views"
      mc:Ignorable="d"
      d:DesignWidth="800"
      d:DesignHeight="680"
      Background="{DynamicResource PrimaryBrush}"
      Foreground="{DynamicResource TextPrimaryBrush}"
      FontFamily="{DynamicResource FontPrimary}"
      Title="Voting Results">

    <!-- Round without a decision (shared with the ICJ result page) -->
    <local:ResultPanel x:Name="Panel"/>
</Page>
