<Page x:Class="Foscamun.Views.CommitteeSessionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:Foscamun.Views"
      mc:Ignorable="d"
      d:DesignWidth="800"
      d:DesignHeight="680"
      Background="{DynamicResource PrimaryBrush}"
      Foreground="{DynamicResource TextPrimaryBrush}"
      FontFamily="{DynamicResource FontPrimary}"
      Title="Committee Session">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- COMMITTEE HEADER: same as Roll call (emblem, name and topic; board on the right).
             MinHeight matches the Roll call band at the default window size. -->
        <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" MinHeight="112">
            <Grid Margin="24,10,28,10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Width="80" Height="80" Margin="0,0,18,0" Stretch="Uniform"
                       VerticalAlignment="Center"
                       Source="{Binding CommitteeName, Converter={StaticResource CommitteeEmblemConverter}, ConverterParameter=Light}"/>

                <!-- Right margin keeps the topic well apart from the chairs -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,60,0">
                    <TextBlock Text="{Binding CommitteeName}" FontSize="24" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- Long topics wrap on up to three lines, then are cut -->
                    <TextBlock Text="{Binding Topic}" FontSize="15" LineHeight="19"
                               LineStackingStrategy="BlockLineHeight" MaxHeight="57"
                               TextWrapping="Wrap" TextTrimming="WordEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Chairs, with the session number underneath (fits within the emblem's height) -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="20,0,0,0">
                        <TextBlock Style="{StaticResource BoardName}" Text="{Binding President}"/>
                        <TextBlock Style="{StaticResource BoardRole}" Text="{DynamicResource PresidentRole}"/>
                    </StackPanel>
                    <StackPanel Margin="20,0,0,0">
                        <TextBlock Style="{StaticResource BoardName}" Text="{Binding VicePresident}"/>
                        <TextBlock Style="{StaticResource BoardRole}" Text="{DynamicResource VicePresidentRole}"/>
                    </StackPanel>
                    <StackPanel Margin="20,0,0,0">
                        <TextBlock Style="{StaticResource BoardName}" Text="{Binding Moderator}"/>
                        <TextBlock Style="{StaticResource BoardRole}" Text="{DynamicResource ModeratorRole}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" Margin="0,8,0,0" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{DynamicResource SessionLbl2}"/>
                    <Run Text="{Binding Session, Mode=OneWay}" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Now speaking, lists, warnings and voting (shared with the ICJ session) -->
        <local:SessionSpeakersPanel Grid.Row="1"/>
    </Grid>
</Page>
