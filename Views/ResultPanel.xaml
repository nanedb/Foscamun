<UserControl x:Class="Foscamun.Views.ResultPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="680"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{DynamicResource FontPrimary}">

    <!-- Body of the committee and ICJ result pages (a round without a decision):
         tally, who voted what, and the three ways on. The page feeds it with Show. -->

    <UserControl.Resources>
        <SolidColorBrush x:Key="InFavorChipBrush" Color="#BFE6CB"/>
        <SolidColorBrush x:Key="AbstainedChipBrush" Color="#F7D9A6"/>
        <SolidColorBrush x:Key="AgainstChipBrush" Color="#F4C2C0"/>

        <!-- Group caption above the chips; the count chip sits on the right, level with the first row -->
        <Style x:Key="GroupCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <!-- Count chip: same colour as the group's voter chips, and as tall -->
        <Style x:Key="CountChip" TargetType="Border">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="GroupCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Voter chip: flag (if any) and name; the chip colour comes from the list's Tag -->
        <DataTemplate x:Key="VoterChip">
            <Border Padding="9,6" Margin="0,0,6,6" CornerRadius="8"
                    Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <StackPanel Orientation="Horizontal">
                    <svgc:SvgViewbox Width="22" Height="15" Margin="0,0,7,0" Stretch="Uniform"
                                     Source="{Binding FlagPath}">
                        <svgc:SvgViewbox.Style>
                            <Style TargetType="svgc:SvgViewbox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FlagPath}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </svgc:SvgViewbox.Style>
                    </svgc:SvgViewbox>
                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="Black"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="ChipsPanel">
            <WrapPanel/>
        </ItemsPanelTemplate>

        <!-- Chips wrap and scroll when there are many voters -->
        <Style x:Key="ChipList" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource VoterChip}"/>
            <Setter Property="ItemsPanel" Value="{StaticResource ChipsPanel}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,26,34,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP: round on the left, how far along on the right -->
        <DockPanel>
            <TextBlock x:Name="RoundOfText" DockPanel.Dock="Right" FontSize="12.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="RoundText" FontSize="11.5" VerticalAlignment="Bottom"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </DockPanel>

        <!-- Why another round is needed, and the tally in favor-abstained-against -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,16">
            <TextBlock x:Name="HeadlineText" FontSize="30" FontWeight="Bold"/>
            <TextBlock x:Name="TallyText" FontSize="14" Margin="12,0,0,5" VerticalAlignment="Bottom"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Bar: green in favor, orange abstained, red against (gradient set in code) -->
        <Border x:Name="TallyBar" Grid.Row="2" Height="12" CornerRadius="6" Margin="0,0,0,20"/>

        <!-- WHO VOTED WHAT: in favor takes the free space, the others sit below -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel>
                <TextBlock x:Name="InFavorCaption" DockPanel.Dock="Top" Style="{StaticResource GroupCaption}"/>
                <Border Style="{StaticResource CountChip}" Background="{StaticResource InFavorChipBrush}">
                    <TextBlock x:Name="InFavorCount" Style="{StaticResource GroupCount}"/>
                </Border>
                <ItemsControl x:Name="InFavorList" Style="{StaticResource ChipList}"
                              Tag="{StaticResource InFavorChipBrush}"/>
            </DockPanel>

            <DockPanel x:Name="AbstainedGroup" Grid.Row="1" Margin="0,8,0,0">
                <TextBlock x:Name="AbstainedCaption" DockPanel.Dock="Top" Style="{StaticResource GroupCaption}"/>
                <Border Style="{StaticResource CountChip}" Background="{StaticResource AbstainedChipBrush}">
                    <TextBlock x:Name="AbstainedCount" Style="{StaticResource GroupCount}"/>
                </Border>
                <ItemsControl x:Name="AbstainedList" Style="{StaticResource ChipList}" MaxHeight="84"
                              Tag="{StaticResource AbstainedChipBrush}"/>
            </DockPanel>

            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock x:Name="AgainstCaption" DockPanel.Dock="Top" Style="{StaticResource GroupCaption}"/>
                <Border Style="{StaticResource CountChip}" Background="{StaticResource AgainstChipBrush}">
                    <TextBlock x:Name="AgainstCount" Style="{StaticResource GroupCount}"/>
                </Border>
                <ItemsControl x:Name="AgainstList" Style="{StaticResource ChipList}" MaxHeight="84"
                              Tag="{StaticResource AgainstChipBrush}"/>
            </DockPanel>
        </Grid>

        <!-- WAYS ON: back to the session, or the next round (main) -->
        <UniformGrid Grid.Row="4" Rows="1" Margin="-5,18,-5,0">
            <Button Style="{StaticResource OutlineButton}" Height="48" FontSize="16" Margin="5,0"
                    BorderBrush="#80FFFFFF" Click="Back_Click">
                <StackPanel Orientation="Horizontal">
                    <svgc:SvgViewbox Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform"
                                     Source="pack://application:,,,/Resources/Icons/back.svg"/>
                    <TextBlock Text="{DynamicResource BackToSessionBtn}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource PrimaryButton}" Height="48" FontWeight="Bold" Margin="5,0"
                    Click="NextRound_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource NextRoundLbl}" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentOnLightBrush}"/>
                    <!-- Arrow in a circle, as on Roll call and Session -->
                    <Grid Width="18" Height="18" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource AccentOnLightBrush}" StrokeThickness="1.6"/>
                        <Path Data="M 5,9 H 12.5 M 9.5,6 L 12.5,9 L 9.5,12"
                              Stroke="{DynamicResource AccentOnLightBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
