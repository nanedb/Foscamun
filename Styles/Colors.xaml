<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== COLOR PALETTE ===================== -->

    <!-- Brand -->
    <Color x:Key="PrimaryColor">#FF5598D3</Color>
    <Color x:Key="PrimaryDarkColor">#FF0A2A44</Color>

    <!-- Translucent surfaces (white at increasing alpha) -->
    <Color x:Key="SurfaceColor">#22FFFFFF</Color>
    <Color x:Key="SurfaceBorderColor">#55FFFFFF</Color>
    <Color x:Key="SurfaceBorderHoverColor">#80FFFFFF</Color>
    <Color x:Key="SurfaceBorderFocusColor">#FFFFFFFF</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#D9D9D9</Color>
    <Color x:Key="TextMutedColor">#A0A0A0</Color>

    <!-- States -->
    <Color x:Key="WarningColor">#FFFFA500</Color>
    <!-- Votes in favor / against (results) -->
    <Color x:Key="InFavorColor">#FF23964B</Color>
    <Color x:Key="AgainstColor">#FFE5484D</Color>

    <!-- ======================== BRUSHES ======================== -->

    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorderColor}"/>
    <SolidColorBrush x:Key="SurfaceBorderHoverBrush" Color="{StaticResource SurfaceBorderHoverColor}"/>
    <SolidColorBrush x:Key="SurfaceBorderFocusBrush" Color="{StaticResource SurfaceBorderFocusColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="InFavorBrush" Color="{StaticResource InFavorColor}"/>
    <SolidColorBrush x:Key="AgainstBrush" Color="{StaticResource AgainstColor}"/>

    <!-- Light input surfaces (text boxes, combos, lists) -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFF2F2EA"/>
    <SolidColorBrush x:Key="TextInputBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="InputHoverBrush" Color="#FFE0E0D6"/>
    <SolidColorBrush x:Key="InputSelectedBrush" Color="#FFD6D6C8"/>
    <!-- Brand blue darkened for text and emblems on light surfaces (contrast ~6.4:1 on InputBackground) -->
    <Color x:Key="AccentOnLightColor">#FF1E5A8C</Color>
    <SolidColorBrush x:Key="AccentOnLightBrush" Color="{StaticResource AccentOnLightColor}"/>

    <!-- Scrollbar thumb: muted grey + alpha, readable on both dark and light surfaces -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#66A0A0A0"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#B3A0A0A0"/>

    <!-- Sidebar gradient (dark navy -> brand blue) -->
    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource PrimaryDarkColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Sidebar: background of the current page's item (navy at 18%) -->
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#2E0A2A44"/>

</ResourceDictionary>
